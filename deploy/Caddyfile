resume.afeiii.com {
    import /etc/caddy/afeiii-indexnow-resume.caddy
    encode zstd gzip
    header >Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com https://afeiii.com; frame-src 'self' https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    header >Strict-Transport-Security "max-age=2592000"
    @security_txt path /.well-known/security.txt /security.txt
    handle @security_txt {
        header Content-Type "text/plain; charset=utf-8"
        header Cache-Control "public, max-age=3600"
        root * /etc/caddy
        rewrite * /security.txt
        file_server
    }
    @baidu_verification path /baidu_verify_codeva-z0otXKas6J.html
    handle @baidu_verification {
        header Content-Type "text/html; charset=utf-8"
        header Cache-Control "public, max-age=3600"
        root * /opt/apps/reactive-resume/site-verification
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Forwarded-For {client_ip}
        }
    }
}
